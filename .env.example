DATABASE_URL="postgresql://user:password@localhost:5432/esport_management?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# --- Optional integrations ---
# Leave blank to disable; the corresponding features degrade gracefully.

# FaceIT Data API key (https://developers.faceit.com) — enables CS2 player stats.
FACEIT_API_KEY=""

# HelloAsso API (https://dev.helloasso.com) — enables membership sync.
HELLOASSO_CLIENT_ID=""
HELLOASSO_CLIENT_SECRET=""
HELLOASSO_ORGANIZATION_SLUG=""
# Base URL — use https://api.helloasso-sandbox.com for the sandbox.
HELLOASSO_API_BASE="https://api.helloasso.com"
